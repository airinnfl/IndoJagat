---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumb from '../components/ui/Breadcrumb.astro'; import Button from '../components/ui/Button.astro'; import IndustrySection from '../components/industry/IndustrySection.astro'; import {industryDetails} from '../data/industries'; import {products} from '../data/products';
---
<BaseLayout title="Solusi Industri | Indo Jagat" description="Solusi equipment untuk konstruksi, pertambangan, manufaktur, pergudangan, pertanian, energi, dan infrastruktur."><Breadcrumb items={[{label:'Industri'}]}/><header class="industry-hero"><div class="container industry-hero-grid"><div><p class="eyebrow">Solusi berdasarkan industri</p><h1>Equipment yang tepat untuk tuntutan kerja yang nyata.</h1><p class="lead">Setiap sektor memiliki ritme, medan, dan risiko berbeda. Kami membantu menghubungkan kebutuhan operasional dengan pilihan equipment dan skema dukungan yang relevan.</p><div class="actions"><Button href="/kontak/" variant="primary">Konsultasikan Kebutuhan</Button><Button href="/produk/" variant="light">Jelajahi Produk</Button></div></div><img src="/images/equipment/photo-1503387762-592deb58ef4e.jpg" alt="Aktivitas alat berat pada kawasan industri" width="1000" height="750"/></div></header><section class="industry-overview"><div class="container"><p class="eyebrow">Sektor yang kami dukung</p><div class="industry-overview-head"><h2>Satu partner untuk kebutuhan operasional yang berbeda.</h2><p>Jelajahi pendekatan, prioritas, solusi, dan equipment yang relevan untuk setiap sektor.</p></div><nav class="industry-nav" aria-label="Navigasi sektor industri">{industryDetails.map((item,i)=><a href={`#${item.slug}`}><span>{String(i+1).padStart(2,'0')}</span>{item.name}</a>)}</nav></div></section>{industryDetails.map((industry,index)=><IndustrySection industry={industry} index={index} products={industry.productSlugs.map(slug=>products.find(p=>p.slug===slug)).filter((p):p is typeof products[number]=>Boolean(p))}/>) }<section class="industry-final-cta"><div class="container"><p class="eyebrow">Bicarakan kebutuhan Anda</p><h2>Setiap industri memiliki tantangan yang berbeda.</h2><p class="lead">Konsultasikan kondisi kerja, target, lokasi, dan durasi kebutuhan agar pilihan equipment dapat dibahas dengan konteks yang jelas.</p><div class="actions"><Button href="/kontak/" variant="primary">Konsultasi dengan Tim Indo Jagat</Button><Button href="/produk/" variant="light">Lihat Semua Produk</Button></div></div></section></BaseLayout>
