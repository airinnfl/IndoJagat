import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumb from '../components/ui/Breadcrumb.astro';import Button from '../components/ui/Button.astro';import ServiceCoverage from '../components/about/ServiceCoverage.astro';
const principles=[['01','Memahami kebutuhan','Kami memulai dari target kerja, kondisi lokasi, jenis aplikasi, dan kebutuhan operasional pengguna.'],['02','Menentukan solusi yang relevan','Equipment dan dukungan dipilih berdasarkan fungsi yang dibutuhkan, bukan sekadar kategori produk.'],['03','Menjaga komunikasi tetap jelas','Informasi kebutuhan, ruang lingkup, dan tindak lanjut disampaikan secara terstruktur.'],['04','Mendukung kesiapan operasional','Inspection, maintenance, dan service support diarahkan untuk membantu unit tetap siap digunakan.']];
---
<BaseLayout title="Tentang Indo Jagat" description="Mengenal pendekatan Indo Jagat dalam memahami kebutuhan equipment, dukungan operasional, keselamatan, dan cakupan layanan demonstrasi."><Breadcrumb items={[{label:'Tentang'}]}/><header class="page-hero"><div class="container"><p class="eyebrow">Profil perusahaan · seluruh data demo</p><h1>Dibangun dekat dengan medan kerja Indonesia.</h1><p class="lead">Indo Jagat adalah perusahaan fiktif yang menggambarkan partner solusi alat berat nasional terintegrasi.</p></div></header><section class="section about-overview"><div class="container detail-grid"><div><p class="eyebrow">Cerita kami</p><h2>Pengalaman lapangan menjadi dasar setiap rekomendasi.</h2></div><div><p class="lead">Kami menyatukan konsultasi aplikasi, pengadaan, rental, dan product support agar pengguna memiliki satu jalur koordinasi.</p><h3>Visi</h3><p>Menjadi partner solusi industrial yang mudah diandalkan di setiap fase proyek.</p><h3>Misi</h3><p>Menghadirkan konfigurasi tepat, respons lugas, dan dukungan yang terukur.</p></div></div></section><section id="nilai-perusahaan" class="about-principles"><div class="container about-principles-grid"><div><p class="eyebrow">Cara kami bekerja</p><h2>Prinsip yang diterapkan dari perencanaan hingga tindak lanjut.</h2><p>Setiap kebutuhan dimulai dengan pemahaman kondisi kerja, pemilihan solusi yang relevan, dan komunikasi yang jelas selama proses berlangsung.</p></div><div class="principle-rows">{principles.map(item=><article><span>{item[0]}</span><div><h3>{item[1]}</h3><p>{item[2]}</p></div></article>)}</div></div></section><section class="about-hse"><div class="container about-hse-grid"><div class="about-hse-copy"><p class="eyebrow">HSE Commitment</p><h2>Keselamatan masuk sejak perencanaan.</h2><p>Site assessment, pemeriksaan unit, briefing mobilisasi, dan komunikasi risiko menjadi bagian dari pendekatan kerja Indo Jagat.</p><aside>Pendekatan HSE merupakan bagian dari perencanaan operasional dan tidak menggantikan SOP, pelatihan, atau ketentuan keselamatan yang berlaku.</aside></div><figure class="about-hse-visual"><img src="/images/equipment/photo-1531834685032-c34bf0d84c77.jpg" alt="Tim lapangan menggunakan helm, rompi, dan perlindungan kerja di area konstruksi" width="1000" height="750" loading="lazy"/><figcaption class="hse-principles">{[['01','Site Assessment','Memahami kondisi area dan kebutuhan pekerjaan.'],['02','Equipment Inspection','Memeriksa kesiapan unit sebelum digunakan.'],['03','Mobilization Briefing','Menyelaraskan proses, akses, dan potensi risiko.']].map(item=><div><span>{item[0]}</span><strong>{item[1]}</strong><p>{item[2]}</p></div>)}</figcaption></figure></div></section><ServiceCoverage/><section class="about-final"><div class="container"><p class="eyebrow">Mulai dari kebutuhan Anda</p><h2>Diskusikan kondisi kerja dan equipment yang dibutuhkan.</h2><p class="lead">Sampaikan aplikasi, lokasi, target, dan durasi kebutuhan agar pembahasan awal memiliki konteks yang jelas.</p><div class="actions"><Button href="/kontak/" variant="primary">Hubungi Indo Jagat</Button><Button href="/produk/" variant="light">Jelajahi Produk</Button></div></div></section></BaseLayout>
