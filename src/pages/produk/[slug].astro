---
import BaseLayout from '../../layouts/BaseLayout.astro';import Breadcrumb from '../../components/ui/Breadcrumb.astro';import ProductCard from '../../components/product/ProductCard.astro';import Button from '../../components/ui/Button.astro';import {products,catalogDisclaimer} from '../../data/products';import type {Product} from '../../types';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}))}
const {product}=Astro.props as {product:Product};
const related=products.filter(p=>p.slug!==product.slug&&p.industries.some(i=>product.industries.includes(i))).slice(0,3);
const canonical=new URL(`/produk/${product.slug}/`,Astro.site).toString();
const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Beranda',item:new URL('/',Astro.site).toString()},{'@type':'ListItem',position:2,name:'Produk',item:new URL('/produk/',Astro.site).toString()},{'@type':'ListItem',position:3,name:product.shortName,item:canonical}]};
---
<BaseLayout title={product.seoTitle} description={product.seoDescription} image={product.image} jsonLd={breadcrumbSchema}>
 <Breadcrumb items={[{label:'Produk',href:'/produk/'},{label:product.shortName}]}/>
 <section class="product-detail-hero section"><div class="container detail-grid"><div><img class="gallery-main" src={product.image} alt={product.imageAlt} width="900" height="700"/><p class="asset-note">Gambar lokal bersifat ilustratif untuk demonstrasi kategori.</p></div><div><p class="eyebrow">{product.category}</p><h1>{product.shortName}</h1><p class="lead">{product.summary}</p><div class="actions"><Button href={`/kontak/?produk=${product.slug}`} variant="primary">Minta Penawaran</Button><Button href={`/kontak/?produk=${product.slug}`} variant="dark">Konsultasikan Kebutuhan</Button></div></div></div></section>
 <section class="section section-muted"><div class="container detail-grid"><div><p class="eyebrow">Spesifikasi teknis</p><h2>Parameter unit.</h2><dl class="spec-list">{product.keySpecifications.map(spec=><div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl></div><div><p class="eyebrow">Penggunaan</p><h2>Fungsi dan aplikasi.</h2><p>{product.description}</p><h3>Fungsi utama</h3><ul>{product.primaryFunctions.map(item=><li>{item}</li>)}</ul><h3>Aplikasi</h3><ul>{product.applications.map(item=><li>{item}</li>)}</ul></div></div></section>
 <section class="section"><div class="container detail-grid"><div><p class="eyebrow">Konfigurasi unit</p><h2>Disesuaikan dengan pekerjaan.</h2><h3>Power type</h3><p>{product.powerType}</p><h3>Fitur</h3><ul>{product.features.map(item=><li>{item}</li>)}</ul></div><div><p class="eyebrow">Attachment</p><h2>Pilihan perlengkapan kerja.</h2><ul>{product.attachments.map(item=><li>{item}</li>)}</ul></div></div></section>
 <section class="section section-muted"><div class="container detail-grid"><div><p class="eyebrow">Layanan pendukung</p><h2>Dukungan yang relevan.</h2><ul class="support-list">{product.supportServices.map(item=><li>{item}</li>)}</ul><a class="product-link inline-link" href="/layanan/">Pelajari layanan Indo Jagat <span aria-hidden="true">→</span></a></div><aside class="availability-note"><p class="eyebrow">Availability</p><h2>Konfirmasi sebelum mobilisasi.</h2><p>{product.availabilityLabel}</p><p>{catalogDisclaimer}</p></aside></div></section>
 {related.length>0&&<section class="section"><div class="container"><p class="eyebrow">Produk terkait</p><h2>Alternatif untuk kebutuhan proyek.</h2><div class="grid grid-3">{related.map(p=><ProductCard product={p}/>)}</div></div></section>}
 <section class="quote-band"><div class="container"><div><p class="eyebrow">Konsultasi unit</p><h2>Petakan kebutuhan sebelum memilih konfigurasi.</h2></div><div class="actions"><Button href={`/kontak/?produk=${product.slug}`} variant="primary">Minta Penawaran</Button><Button href={`/kontak/?produk=${product.slug}`} variant="light">Konsultasikan Kebutuhan</Button></div></div></section>
</BaseLayout>
<style>.product-detail-hero h1{font-size:var(--font-h1-inner);max-width:15ch}.equipment-class{font-size:1.15rem;font-weight:600}.asset-note{font-size:.78rem;color:var(--color-gravel);margin-top:.75rem}.spec-list{margin:0}.spec-list div{display:grid;grid-template-columns:minmax(150px,.8fr) 1.2fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-pebble)}.spec-list dt{color:var(--color-gravel)}.spec-list dd{margin:0;font-weight:600}.support-list{columns:2}.availability-note{border-top:4px solid var(--yellow);padding-top:1.5rem}.inline-link{max-width:360px}@media(max-width:600px){.spec-list div{grid-template-columns:1fr;gap:.25rem}.support-list{columns:1}}</style>
