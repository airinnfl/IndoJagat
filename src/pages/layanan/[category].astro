---
import BaseLayout from '../../layouts/BaseLayout.astro';import Breadcrumb from '../../components/ui/Breadcrumb.astro';import Button from '../../components/ui/Button.astro';import {serviceCategories} from '../../data/services';import type {ServiceCategory} from '../../data/services';
export function getStaticPaths(){return serviceCategories.map(category=>({params:{category:category.slug},props:{category}}))}
const {category}=Astro.props as {category:ServiceCategory};
const other=serviceCategories.find(item=>item.slug!==category.slug)!;
const canonical=new URL(`/layanan/${category.slug}/`,Astro.site).toString();
const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Beranda',item:new URL('/',Astro.site).toString()},{'@type':'ListItem',position:2,name:'Layanan',item:new URL('/layanan/',Astro.site).toString()},{'@type':'ListItem',position:3,name:category.name,item:canonical}]};
---
<BaseLayout title={category.seoTitle} description={category.seoDescription} image={category.image} jsonLd={breadcrumbSchema}>
 <Breadcrumb items={[{label:'Layanan',href:'/layanan/'},{label:category.name}]}/>
 <header class="category-hero"><div class="container category-hero-grid"><div><p class="eyebrow">{category.eyebrow}</p><h1>{category.title}</h1><p class="lead">{category.description}</p><div class="actions"><Button href="/produk/" variant="primary">Lihat Produk</Button><Button href="/kontak/" variant="light">Contact Us</Button></div></div><img src={category.image} alt={category.imageAlt} width="1000" height="750"/></div></header>
 <section class="service-items section"><div class="container"><p class="eyebrow">{category.name}</p><h2>Layanan dalam kategori ini.</h2><div class="service-item-list">{category.services.map((service,index)=><article id={service.slug} class="service-item"><div class="service-item-heading"><span>{String(index+1).padStart(2,'0')}</span><div><h3>{service.name}</h3><p>{service.description}</p></div></div><div class="service-item-scope"><h4>Ruang lingkup demonstratif</h4><ul>{service.scope.map(item=><li>{item}</li>)}</ul><a class="btn btn-dark" href={`/kontak/?service=${service.slug}`}>{service.ctaLabel}</a></div></article>)}</div><aside class="service-note"><strong>{category.slug==='operational-support'?'Catatan keselamatan':'Catatan layanan'}</strong><p>{category.note}</p></aside></div></section>
 <section class="category-links"><div class="container category-links-grid"><div><p class="eyebrow">Layanan lainnya</p><h2>{other.title}</h2><a class="text-link" href={`/layanan/${other.slug}/`}>Lihat {other.name} <span aria-hidden="true">→</span></a></div><div><p class="eyebrow">Kebutuhan unit</p><h2>Diskusikan konteks pekerjaan Anda.</h2><div class="actions"><Button href="/kontak/" variant="primary">Contact Us</Button><Button href="/produk/" variant="light">Lihat Produk</Button></div></div></div></section>
</BaseLayout>
<style>.service-note{background:var(--color-graphite)!important;color:var(--color-text-on-dark)!important;border-left-color:var(--yellow)!important}.service-note strong{color:var(--color-text-on-dark);font-size:1rem}.service-note p{color:var(--color-mist)!important;line-height:1.65}</style>
<style>.category-hero{background:var(--color-obsidian);color:var(--color-text-on-dark)}.category-hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;min-height:580px}.category-hero-grid>div{padding:clamp(3rem,7vw,6rem) clamp(2rem,5vw,5rem) clamp(3rem,7vw,6rem) 0}.category-hero h1{font-size:clamp(2.7rem,6vw,5.5rem);max-width:12ch}.category-hero .lead{color:var(--color-mist)}.category-hero img{width:100%;height:100%;min-height:580px}.service-items h2{font-size:clamp(2rem,4vw,3.5rem)}.service-item{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);padding:clamp(2.5rem,5vw,4.5rem) 0;border-top:1px solid var(--color-pebble)}.service-item-heading{display:grid;grid-template-columns:3rem 1fr;gap:1rem}.service-item-heading>span{font-size:.75rem;color:var(--color-gravel)}.service-item h3{font-size:clamp(1.6rem,3vw,2.5rem)}.service-item-scope h4{margin-top:0}.service-item-scope ul{columns:2;padding-left:1.2rem;margin-bottom:2rem}.service-item-scope li{break-inside:avoid;margin-bottom:.55rem}.service-note{border-left:5px solid var(--yellow);padding:1.25rem 1.5rem;background:var(--color-limestone);max-width:900px}.service-note p{margin:.4rem 0 0}.category-links{background:var(--color-graphite);color:var(--color-text-on-dark);padding:var(--section-space) 0}.category-links-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,7rem)}.category-links h2{font-size:clamp(1.8rem,3vw,3rem)}.text-link{display:inline-flex;gap:1rem;border-top:2px solid var(--yellow);padding-top:1rem;font-weight:700}@media(max-width:800px){.category-hero-grid,.service-item,.category-links-grid{grid-template-columns:1fr}.category-hero-grid>div{padding:3.5rem 0}.category-hero img{min-height:320px;max-height:440px}.service-item-scope ul{columns:1}}@media(max-width:600px){.service-item-heading{grid-template-columns:2rem 1fr}}</style>
