---
import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumb from '../components/ui/Breadcrumb.astro';import {locations} from '../data/content';import {products,categories} from '../data/products';import {serviceItems} from '../data/services';
---
<BaseLayout title="Kontak & Request Quote | Indo Jagat"><Breadcrumb items={[{label:'Kontak'}]}/><header class="page-hero"><div class="container"><p class="eyebrow">Request quote</p><h1>Mari petakan kebutuhan proyek Anda.</h1><p class="lead">Lengkapi konteks pekerjaan agar tim demo kami dapat menyusun respons yang lebih tepat.</p></div></header><section class="section"><div class="container detail-grid"><div><form id="quote-form" class="form-grid" novalidate><div class="field"><label for="name">Nama *</label><input id="name" name="name" autocomplete="name" required/></div><div class="field"><label for="company">Perusahaan *</label><input id="company" name="company" autocomplete="organization" required/></div><div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" autocomplete="email" required/></div><div class="field"><label for="phone">Telepon *</label><input id="phone" name="phone" type="tel" autocomplete="tel" required/></div><div class="field"><label for="need">Kebutuhan</label><select id="need" name="need"><option value="">Belum ditentukan</option><option value="product-inquiry">Konsultasi produk</option>{serviceItems.map(service=><option value={service.slug}>{service.name}</option>)}</select></div><div class="field"><label for="category">Kategori unit</label><select id="category" name="category"><option value="">Belum ditentukan</option>{categories.map(c=><option value={c[0]}>{c[1]}</option>)}</select></div><div class="field"><label for="model">Produk</label><select id="model" name="model"><option value="">Belum ditentukan</option>{products.map(p=><option value={p.slug}>{p.shortName}</option>)}</select></div><div class="field"><label for="location">Lokasi proyek *</label><input id="location" name="location" required/></div><div class="field"><label for="duration">Durasi</label><input id="duration" name="duration" placeholder="Contoh: 6 bulan"/></div><div class="field field-full"><label for="message">Pesan *</label><textarea id="message" name="message" rows="5" required></textarea></div><div class="field-full"><label><input id="consent" name="consent" type="checkbox" required/> Saya setuju data digunakan untuk menanggapi permintaan demo ini. *</label></div><p id="form-error" class="field-full" role="alert"></p><div id="form-success" class="notice field-full" role="status">Terima kasih. Permintaan demo Anda berhasil dicatat. Tidak ada data yang dikirim ke backend.</div><button class="btn btn-primary field-full" type="submit">Kirim Permintaan</button></form></div><aside><h2>Kami siap mendengar.</h2><p>WhatsApp demo<br/><strong>+62 811 0000 247</strong></p><p>Email demo<br/><strong>hello@demo.indojagat.co.id</strong></p><div class="contact-map"><iframe title="Peta wilayah Jabodetabek" src="https://www.openstreetmap.org/export/embed.html?bbox=106.45%2C-6.45%2C107.10%2C-5.95&amp;layer=mapnik" loading="lazy"></iframe><button class="contact-map-marker" type="button" aria-label="Marker demonstrasi area Jakarta"></button></div></aside></div></section><section class="section section-muted"><div class="container"><h2>Titik dukungan demo.</h2><div class="grid grid-4">{locations.map(location=><address class="card card-body"><h3>{location[0]}</h3><p>{location[1]}</p><p>{location[2]}</p></address>)}</div></div></section></BaseLayout>
<script>const form=document.querySelector<HTMLFormElement>('#quote-form')!,model=document.querySelector<HTMLSelectElement>('#model')!,need=document.querySelector<HTMLSelectElement>('#need')!,params=new URLSearchParams(location.search);const requestedProduct=params.get('produk'),requestedService=params.get('service');if(requestedProduct){model.value=requestedProduct;need.value='product-inquiry'}if(requestedService)need.value=requestedService;form.addEventListener('submit',event=>{event.preventDefault();const error=document.querySelector<HTMLElement>('#form-error')!,success=document.querySelector<HTMLElement>('#form-success')!;if(!form.checkValidity()){error.textContent='Mohon lengkapi semua kolom wajib dengan format yang benar.';success.style.display='none';form.reportValidity();return}error.textContent='';success.style.display='block';form.reset();success.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'})})</script>
