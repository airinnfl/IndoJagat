---
import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumb from '../components/ui/Breadcrumb.astro';import Button from '../components/ui/Button.astro';import {serviceCategories} from '../data/services';
---
<BaseLayout title="Layanan Alat Berat | Indo Jagat" description="Unit Care dan Operational Support untuk pemeriksaan, perawatan, rental, parts, mobilisasi, dan koordinasi lifting.">
 <Breadcrumb items={[{label:'Layanan'}]}/>
 <header class="service-hero"><div class="container service-hero-grid"><div><p class="eyebrow">Layanan & Product Support</p><h1>Dukungan sesuai siklus pekerjaan.</h1><p class="lead">Pilih dukungan untuk menjaga kondisi unit atau membantu kebutuhan operasional proyek.</p><div class="actions"><Button href="/kontak/" variant="primary">Ajukan Kebutuhan</Button><Button href="/produk/" variant="light">Lihat Produk</Button></div></div><img src="/images/equipment/photo-1581092160607-ee22621dd758.jpg" alt="Pemeriksaan equipment di area kerja" width="1000" height="750"/></div></header>
 <main class="service-hub" aria-label="Kategori layanan">{serviceCategories.map((category,index)=><a class:list={['service-feature-link',category.slug==='unit-care'&&'is-dark',index%2===1&&'is-reversed']} href={`/layanan/${category.slug}/`} aria-label={`Pelajari layanan ${category.name}`}><div class="container service-feature-grid"><div class="service-feature-copy"><p class="eyebrow">{category.eyebrow}</p><h2>{category.title}</h2><p>{category.description}</p><ul>{category.services.map(service=><li>{service.name}</li>)}</ul><span class="feature-cta">Lihat {category.name} <span aria-hidden="true">→</span></span></div><img src={category.image} alt={category.imageAlt} width="1000" height="750" loading={index?'lazy':'eager'}/></div></a>)}</main>
</BaseLayout>
<style>
:global(.page-layanan) .service-feature-link{display:block;background:var(--color-limestone);color:var(--color-obsidian);cursor:pointer}
:global(.page-layanan) .service-feature-link .service-feature-copy{background:transparent;color:inherit}
:global(.page-layanan) .service-feature-link.is-dark,:global(.page-layanan) .service-feature-link.is-dark .service-feature-copy{background:var(--color-obsidian);color:var(--color-text-on-dark)}
:global(.page-layanan) .service-feature-link:not(.is-dark),:global(.page-layanan) .service-feature-link:not(.is-dark) .service-feature-copy{background:var(--color-limestone);color:var(--color-obsidian)}
.service-feature-link:focus-visible{outline:4px solid var(--yellow);outline-offset:-4px}.service-feature-grid{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;min-height:560px}.service-feature-link.is-reversed .service-feature-copy{order:2}.service-feature-link.is-reversed img{order:1}.service-feature-copy{padding:clamp(3rem,7vw,6rem);align-self:center}.service-feature-copy h2{font-size:clamp(2rem,4vw,3.6rem);max-width:13ch}.service-feature-copy>p{max-width:58ch}.service-feature-copy ul{list-style:none;padding:0;margin:2rem 0}.service-feature-copy li{padding:.65rem 0;border-bottom:1px solid currentColor}.service-feature-grid img{width:100%;height:100%;min-height:520px}.feature-cta{display:flex;align-items:center;justify-content:space-between;max-width:300px;font-weight:700;border-top:2px solid var(--yellow);padding-top:1rem}.feature-cta span{transition:transform .2s}.service-feature-link:hover .feature-cta span{transform:translateX(6px)}
@media(max-width:800px){.service-feature-grid{grid-template-columns:1fr;min-height:0}.service-feature-link.is-reversed .service-feature-copy,.service-feature-link.is-reversed img{order:initial}.service-feature-copy{padding:3rem var(--page-padding)}.service-feature-grid img{min-height:320px;max-height:440px}}
@media(prefers-reduced-motion:reduce){.feature-cta span{transition:none}.service-feature-link:hover .feature-cta span{transform:none}}
</style>
