---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import {categoryLabels,publishedArticles} from '../../data/articles';
const active=publishedArticles(); const featured=active.find(a=>a.featured)??active[0]; const categories=['Semua',...categoryLabels];
const formatDate=(date:string)=>new Date(`${date}T00:00:00+07:00`).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
---
<BaseLayout title="Blog & Insight | Indo Jagat" description="Panduan praktis mengenai alat berat, rental, maintenance, keselamatan, dan operasional industri.">
<Breadcrumb items={[{label:'Blog'}]}/><header class="page-hero"><div class="container"><p class="eyebrow">Knowledge hub</p><h1>Blog & Insight</h1><p class="lead">Panduan praktis untuk memilih, menggunakan, dan merawat equipment dengan pertimbangan operasional yang bertanggung jawab.</p></div></header>
<section class="section"><div class="container"><p class="eyebrow">Artikel pilihan</p><article class="blog-feature"><img src={featured.image} alt={featured.imageAlt} width="900" height="560"/><div><p class="eyebrow">{featured.category}</p><h2>{featured.title}</h2><p class="lead">{featured.description}</p><time datetime={featured.publishedAt}>{formatDate(featured.publishedAt)}</time><div class="actions"><a class="btn btn-primary" href={`/blog/${featured.slug}/`}>Baca Artikel →</a></div></div></article></div></section>
<section class="section section-muted"><div class="container"><div class="section-head"><div><p class="eyebrow">Artikel terbaru</p><h2>Temukan topik yang relevan.</h2></div></div><div class="blog-filters" role="group" aria-label="Filter kategori">{categories.map((c,i)=><button type="button" class:list={['tab',i===0&&'active']} data-filter={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><p class="results-label" aria-live="polite"><span id="article-count">{active.length}</span> artikel</p><div class="grid grid-3">{active.map(a=><article class="card article-card" data-category={a.category}><a href={`/blog/${a.slug}/`}><img class="card-media" src={a.image} alt={a.imageAlt} width="720" height="540" loading="lazy"/></a><div class="card-body"><p class="eyebrow">{a.category}</p><h3><a href={`/blog/${a.slug}/`}>{a.title}</a></h3><p>{a.description}</p><time datetime={a.publishedAt}>{formatDate(a.publishedAt)}</time><a class="article-link" href={`/blog/${a.slug}/`}>Baca selengkapnya →</a></div></article>)}</div><div id="article-empty" class="empty" role="status"><h2>Belum ada artikel</h2><p>Pilih kategori lain untuk melihat artikel.</p></div></div></section></BaseLayout>
<script>const bs=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')],cs=[...document.querySelectorAll<HTMLElement>('.article-card')],count=document.querySelector('#article-count')!,empty=document.querySelector<HTMLElement>('#article-empty')!;bs.forEach(b=>b.addEventListener('click',()=>{bs.forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false')});b.classList.add('active');b.setAttribute('aria-pressed','true');let n=0;cs.forEach(c=>{const show=b.dataset.filter==='Semua'||c.dataset.category===b.dataset.filter;c.hidden=!show;if(show)n++});count.textContent=String(n);empty.style.display=n?'none':'block'}));</script>
