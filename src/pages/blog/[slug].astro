---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/ui/Breadcrumb.astro'; import {getRelatedArticles,publishedArticles} from '../../data/articles'; import type {Article} from '../../types';
export function getStaticPaths(){return publishedArticles().map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props as {article:Article}; const related=getRelatedArticles(article); const fallbackProduct=article.slug.includes('forklift')?'/produk/forklift/':'/produk/hydraulic-excavator-20-ton/'; const requiredResources=[{label:'Katalog Produk',href:'/produk/',description:'Bandingkan pilihan equipment yang tersedia.'},{label:'Produk yang Relevan',href:fallbackProduct,description:'Tinjau fungsi dan spesifikasi demonstratif unit.'},{label:article.category==='Maintenance'?'Unit Care':'Operational Support',href:article.category==='Maintenance'?'/layanan/unit-care/':'/layanan/operational-support/',description:'Pelajari dukungan teknis dan operasional.'},{label:'Contact Us',href:'/kontak/',description:'Sampaikan kebutuhan dan kondisi proyek.'}]; const pageResources=[...article.relatedProducts,...requiredResources.filter(item=>!article.relatedProducts.some(existing=>existing.href===item.href))]; const canonical=new URL(`/blog/${article.slug}/`,Astro.site).toString(); const fmt=(d:string)=>new Date(`${d}T00:00:00+07:00`).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
const jsonLd=[{'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.seoDescription,image:new URL(article.image,Astro.site).toString(),datePublished:article.publishedAt,dateModified:article.updatedAt??article.publishedAt,mainEntityOfPage:canonical,author:{'@type':'Organization',name:article.author},publisher:{'@type':'Organization',name:'Indo Jagat'}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Beranda',item:new URL('/',Astro.site).toString()},{'@type':'ListItem',position:2,name:'Blog',item:new URL('/blog/',Astro.site).toString()},{'@type':'ListItem',position:3,name:article.title,item:canonical}]}];
---
<BaseLayout title={article.seoTitle} description={article.seoDescription} image={article.image} ogType="article" publishedTime={article.publishedAt} modifiedTime={article.updatedAt??article.publishedAt} author={article.author} jsonLd={jsonLd}><Breadcrumb items={[{label:'Blog',href:'/blog/'},{label:article.title}]}/><article><header class="article-hero"><div class="container"><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lead">{article.description}</p><div class="article-meta"><time datetime={article.publishedAt}>{fmt(article.publishedAt)}</time>{article.updatedAt&&article.updatedAt!==article.publishedAt&&<><span>·</span><span>Diperbarui <time datetime={article.updatedAt}>{fmt(article.updatedAt)}</time></span></>}<span>·</span><span>{article.author}</span></div></div></header><div class="container article-image-wrap"><img src={article.image} alt={article.imageAlt} width="1280" height="720"/></div><div class="container section article-body">{article.intro.map(x=><p class="article-lead">{x}</p>)}{article.sections.map((s,i)=><section id={`bagian-${i+1}`}><p class="eyebrow">{String(i+1).padStart(2,'0')}</p><h2>{s.heading}</h2>{s.paragraphs.map(x=><p>{x}</p>)}{s.bullets&&<ul>{s.bullets.map(x=><li>{x}</li>)}</ul>}</section>)}<section class="article-conclusion"><h2>Kesimpulan dan langkah berikutnya</h2><p>{article.conclusion}</p></section>{article.references&&<section><p class="eyebrow">Referensi</p><h2>Sumber teknis</h2><ul>{article.references.map(source=><li><a href={source.href} rel="noopener noreferrer">{source.label}</a></li>)}</ul></section>}{article.disclaimer&&<aside class="article-disclaimer"><strong>Catatan penting</strong><p>{article.disclaimer}</p></aside>}</div></article><section class="section section-dark"><div class="container cta-grid"><div><p class="eyebrow">Langkah berikutnya</p><h2>{article.cta.text}</h2><a class="btn btn-primary" href={article.cta.href}>{article.cta.label}</a></div><aside><p class="eyebrow">Produk & layanan terkait</p>{pageResources.map(x=><a class="related-resource" href={x.href}><strong>{x.label}</strong><span>{x.description}</span><span>→</span></a>)}</aside></div></section><section class="section section-muted"><div class="container"><div class="section-head"><div><p class="eyebrow">Artikel terkait</p><h2>Bacaan berikutnya.</h2></div></div><div class="grid grid-3">{related.map(a=><article class="card article-card"><a href={`/blog/${a.slug}/`}><img class="card-media" src={a.image} alt={a.imageAlt} width="720" height="540" loading="lazy"/></a><div class="card-body"><p class="eyebrow">{a.category}</p><h3><a href={`/blog/${a.slug}/`}>{a.title}</a></h3><p>{a.description}</p></div></article>)}</div></div></section></BaseLayout>
