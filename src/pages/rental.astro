---
import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumb from '../components/ui/Breadcrumb.astro';import Button from '../components/ui/Button.astro';import FAQAccordion from '../components/ui/FAQAccordion.astro';import {faqs} from '../data/content';
---
<BaseLayout title="Rental Alat Berat | Indo Jagat" description="Proses rental alat berat berdasarkan kebutuhan unit, lokasi, durasi, akses, dan jadwal proyek."><Breadcrumb items={[{label:'Rental'}]}/><header class="page-hero"><div class="container"><p class="eyebrow">Rental alat berat</p><h1>Unit dipilih dari kebutuhan pekerjaan.</h1><p class="lead">Sampaikan aplikasi, kapasitas, lokasi, durasi, dan akses agar konfigurasi serta model penyediaan dapat ditinjau.</p></div></header><section class="section"><div class="container grid grid-4">{[['01','Petakan kebutuhan','Tentukan pekerjaan, material, kapasitas, dan target.'],['02','Tinjau lokasi','Periksa akses, medan, ruang kerja, dan keselamatan.'],['03','Konfirmasi unit','Validasi konfigurasi, availability, dan cakupan dukungan.'],['04','Koordinasi mobilisasi','Susun rute dan jadwal sesuai kesiapan lokasi.']].map(x=><article class="card card-body"><p class="eyebrow">{x[0]}</p><h3>{x[1]}</h3><p>{x[2]}</p></article>)}</div></section><section class="section section-dark"><div class="container detail-grid"><div><p class="eyebrow">Tanpa estimasi fiktif</p><h2>Penawaran disusun dari konteks proyek.</h2><p class="lead">Website demonstrasi ini tidak menampilkan harga atau stok. Tim akan meninjau kelas unit, durasi, lokasi, operator, mobilisasi, dan dukungan yang diperlukan.</p></div><div class="actions"><Button href="/produk/" variant="primary">Lihat Katalog</Button><Button href="/kontak/" variant="light">Minta Penawaran</Button></div></div></section><section class="section"><div class="container detail-grid"><div><p class="eyebrow">FAQ rental</p><h2>Sebelum mobilisasi.</h2></div><FAQAccordion items={faqs}/></div></section></BaseLayout>
