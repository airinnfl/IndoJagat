---
import '../styles/global.css'; import Header from '../components/global/Header.astro'; import Footer from '../components/global/Footer.astro';
const {title='Indo Jagat',description='Solusi alat berat dan industri untuk proyek di seluruh Indonesia.',image='/images/brand/indo-jagat-logo.png',jsonLd,ogType='website',publishedTime,modifiedTime,author}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site); const routeKey=Astro.url.pathname.split('/').filter(Boolean)[0]||'home';
---
<!doctype html><html lang="id"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/><meta name="description" content={description}/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="Blog Indo Jagat" href="/rss.xml"/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={ogType}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site)}/>{publishedTime&&<meta property="article:published_time" content={publishedTime}/>} {modifiedTime&&<meta property="article:modified_time" content={modifiedTime}/>} {author&&<meta property="article:author" content={author}/>}<title>{title}</title>{jsonLd&&<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>}</head><body class={`page-${routeKey}`}><a class="skip" href="#main">Lewati ke konten</a><Header/><main id="main"><slot/></main><Footer/><script>const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;if(!reduce&&'IntersectionObserver'in window){document.documentElement.classList.add('motion-ready');const selector='.section-head,.industry-solutions-head,.service-heading,.service-intro-grid,.service-feature-grid,.service-group-grid,.service-diagnosis-grid,.service-faq-grid,.service-process,.card,.pillar,.industry-card,.industry-tile,.industry-sector-grid,.benefit,.testimonial,.blog-feature,.faq,.quote-band .container,.service-final .container,.about-final .container';const targets=[...document.querySelectorAll<HTMLElement>(selector)];const groups=new Map<Element,number>();targets.forEach(el=>{const parent=el.parentElement??document.body;const index=groups.get(parent)??0;groups.set(parent,index+1);el.classList.add('reveal');el.style.setProperty('--reveal-delay',`${Math.min(index,5)*70}ms`)});const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target)}}),{threshold:.1,rootMargin:'0px 0px -32px'});targets.forEach(el=>observer.observe(el))}</script></body></html>
