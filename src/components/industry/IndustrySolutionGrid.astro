---
import {industrySolutions} from '../../data/industries';
import '../../styles/industry-home.css';
---
<section class="industry-solutions section" aria-labelledby="industry-solutions-title"><div class="container"><header class="industry-solutions-head"><div><p class="eyebrow">SOLUSI INDUSTRI</p><h2 id="industry-solutions-title">Equipment untuk berbagai kebutuhan operasional.</h2></div><div><p>Temukan kelas unit dan dukungan yang sesuai berdasarkan kondisi kerja, material, kapasitas, serta kebutuhan proyek.</p><a href="/produk/">Jelajahi semua produk <span aria-hidden="true">→</span></a></div></header><div class="industry-editorial-grid">{industrySolutions.map(industry=><a class:list={['industry-tile',industry.gridClass]} href={industry.href} aria-label={industry.accessibleLabel}><img src={industry.image} alt={industry.imageAlt} width="1200" height="900" loading="lazy"/><span class="industry-tile-number">{industry.number}</span><div class="industry-tile-content"><h3>{industry.name}</h3><p>{industry.description}</p><small>{industry.relatedProducts.join(' · ')}</small></div><span class="industry-tile-arrow" aria-hidden="true">→</span></a>)}</div></div></section>
<style>.industry-solutions{background:var(--color-obsidian);color:var(--color-text-on-dark)}.industry-solutions-head{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,7vw,7rem);align-items:end;margin-bottom:clamp(2rem,4vw,3.5rem)}.industry-solutions-head h2{font-size:clamp(2rem,4vw,3.7rem);max-width:15ch;margin-bottom:0}.industry-solutions-head>div:last-child p{color:var(--color-mist);max-width:55ch}.industry-solutions-head a{display:inline-flex;gap:.75rem;border-bottom:1px solid var(--yellow);padding-bottom:.35rem;font-weight:650}.industry-editorial-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:repeat(4,190px);gap:2px;background:var(--color-graphite);border:1px solid var(--color-graphite)}.industry-tile{position:relative;isolation:isolate;overflow:hidden;border:1px solid transparent;cursor:pointer;color:var(--color-text-on-dark)}.industry-tile--construction{grid-column:span 7;grid-row:span 2}.industry-tile--mining{grid-column:span 5;grid-row:span 2}.industry-tile--warehouse{grid-column:span 5;grid-row:span 2}.industry-tile--infrastructure,.industry-tile--agriculture,.industry-tile--lifting{grid-column:span 4;grid-row:span 2}.industry-tile img{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .26s ease,filter .26s ease;filter:saturate(.72)}.industry-tile:after{content:'';position:absolute;z-index:-1;inset:auto 0 0;height:68%;background:rgba(26,26,26,.78);transition:background .25s}.industry-tile-number{position:absolute;top:1.15rem;left:1.15rem;color:var(--yellow);font-size:.75rem;font-weight:700;letter-spacing:.12em}.industry-tile-content{position:absolute;left:1.25rem;right:3.5rem;bottom:1.25rem}.industry-tile h3{font-size:clamp(1.3rem,2vw,2rem);margin-bottom:.45rem}.industry-tile p{font-size:.86rem;line-height:1.45;margin-bottom:.7rem;max-width:58ch}.industry-tile small{display:block;color:var(--color-mist);font-size:.68rem;line-height:1.5}.industry-tile-arrow{position:absolute;right:1.25rem;bottom:1.25rem;font-size:1.35rem;transition:transform .25s,color .25s}.industry-tile:hover{border-color:var(--yellow)}.industry-tile:hover img{transform:scale(1.03);filter:saturate(.9)}.industry-tile:hover:after{background:rgba(26,26,26,.7)}.industry-tile:hover .industry-tile-arrow{transform:translateX(5px);color:var(--yellow)}.industry-tile:focus-visible{outline:4px solid var(--yellow);outline-offset:-4px;z-index:2}@media(max-width:1023px){.industry-solutions-head{grid-template-columns:1fr}.industry-editorial-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto}.industry-tile,.industry-tile--construction,.industry-tile--mining,.industry-tile--warehouse,.industry-tile--infrastructure,.industry-tile--agriculture,.industry-tile--lifting{grid-column:span 1;grid-row:auto;min-height:380px}.industry-tile--construction{grid-column:1/-1;min-height:460px}}@media(max-width:767px){.industry-editorial-grid{grid-template-columns:1fr}.industry-tile,.industry-tile--construction{grid-column:1;min-height:330px}.industry-tile--construction{min-height:380px}.industry-tile--infrastructure{order:4}.industry-tile--agriculture{order:5}.industry-tile-content{right:3rem}.industry-tile p{font-size:.82rem}}@media(prefers-reduced-motion:reduce){.industry-tile img,.industry-tile:after,.industry-tile-arrow{transition:none}.industry-tile:hover img,.industry-tile:hover .industry-tile-arrow{transform:none}}</style>
