---
import type {IndustryDetail} from '../../data/industries'; import type {Product} from '../../types';
const {industry,index,products}=Astro.props as {industry:IndustryDetail;index:number;products:Product[]}; const dark=index%2===1;
---
<section id={industry.slug} class:list={['industry-sector',dark&&'is-dark']}><div class:list={['container','industry-sector-grid',index%2===1&&'is-reversed']}><div class="industry-copy"><p class="industry-index">{String(index+1).padStart(2,'0')} <span>SEKTOR INDUSTRI</span></p><h2>{industry.name}</h2><p class="industry-summary">{industry.summary}</p><div class="industry-mobile-visual"><img src={industry.image} alt={industry.imageAlt} width="900" height="675" loading="lazy"/></div><div class="industry-detail-columns"><div><h3>Prioritas operasional</h3><ol class="priority-list">{industry.priorities.map((item,i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><strong>{item.title}</strong><p>{item.description}</p></div></li>)}</ol></div><div><h3>Solusi Indo Jagat</h3><ul class="solution-list">{industry.solutions.map(item=><li>{item}</li>)}</ul></div></div><div class="industry-actions"><a href={industry.categoryHref}>Lihat equipment terkait <span aria-hidden="true">→</span></a><a href={`/kontak/?industri=${industry.slug}`}>Diskusikan kebutuhan <span aria-hidden="true">→</span></a></div></div><div class="industry-visual"><img src={industry.image} alt={industry.imageAlt} width="900" height="675" loading="lazy"/><div class="equipment-list"><p class="eyebrow">Equipment yang direkomendasikan</p>{products.map(product=><a href={`/produk/${product.slug}/`}><span><strong>{product.name}</strong><small>{product.category}</small></span><span>{product.equipmentClass} →</span></a>)}</div></div></div></section>
